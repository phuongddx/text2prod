#!/usr/bin/env bash
# SessionStart hook for text2prod plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read zed-mode content
zed_mode_content=$(cat "${PLUGIN_ROOT}/skills/zed-mode/SKILL.md" 2>&1 || echo "Error reading zed-mode skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

zed_mode_escaped=$(escape_for_json "$zed_mode_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have text2prod.\n\n**Below is the full content of your 'text2prod:zed-mode' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${zed_mode_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON for Claude Code hooks
# (hookSpecificOutput.additionalContext, nested).
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat

exit 0
